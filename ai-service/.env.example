OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45

ML_ENABLED=true
ML_MODEL_PATH=models/log_classifier.joblib
# Calibrated against datasets/evaluation_cases.jsonl after switching train_model.py to
# CalibratedClassifierCV: raw predict_proba on the old uncalibrated LogisticRegression
# never crossed a 75% threshold even when correct. Re-run evaluate_ml.py after retraining
# with more data and adjust this number based on its output, not by guessing.
# Enabled by default here because a trained + calibrated model ships in models/ for the
# demo (see ai-service/README.md for the evaluation numbers). Set to false, or retrain
# on your own data first, before using this anywhere beyond a portfolio/demo.
ML_MINIMUM_CONFIDENCE=60
